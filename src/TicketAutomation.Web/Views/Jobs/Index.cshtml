@model IReadOnlyList<TicketJob>
@{ ViewData["Title"] = "تیکت‌ها و گزارش‌ها"; }
<div class="page-heading d-flex justify-content-between align-items-end"><div><span class="eyebrow">صف پردازش</span><h1>تیکت‌ها و گزارش‌ها</h1><p>این اطلاعات فقط در دیتابیس داخلی Orchestrator ذخیره شده‌اند.</p></div><form asp-action="PollNow" method="post"><button class="btn btn-primary">بررسی همین حالا</button></form></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="panel"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>شناسه</th><th>عنوان</th><th>Provider</th><th>وضعیت</th><th>Branch</th><th>زمان</th></tr></thead><tbody>
@if (Model.Count == 0) { <tr><td colspan="6" class="empty-state">موردی یافت نشد.</td></tr> }
@foreach (var job in Model)
{
    <tr><td><a asp-action="Details" asp-route-id="@job.Id">#@job.ExternalTicketId</a></td><td>@job.Title</td><td>@job.Provider</td><td><span class="badge status-@job.Status.ToString().ToLowerInvariant()">@job.Status</span></td><td class="ltr"><code>@(job.BranchName ?? "—")</code></td><td class="ltr">@job.DiscoveredAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td></tr>
}
</tbody></table></div></div>
