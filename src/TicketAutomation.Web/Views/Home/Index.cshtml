@model DashboardViewModel
@{ ViewData["Title"] = "داشبورد"; }

@if (!Model.AuthenticationEnabled)
{
    <div class="alert alert-warning">ورود مدیریتی غیرفعال است. پیش از استقرار، بخش <code>Admin</code> را در تنظیمات محیط فعال کنید.</div>
}
<div class="hero-panel mb-4">
    <div><span class="eyebrow">مرکز کنترل اصلاح تیکت‌ها</span><h1>تبدیل کنترل‌شده تیکت به Feature Branch</h1><p>تیکت‌ها فقط خوانده می‌شوند؛ اصلاحات با <strong>@Model.Settings.SelectedProvider</strong> در شاخه جدا ساخته و گزارش داخل همین سامانه ذخیره می‌شود.</p></div>
    <div class="hero-status"><span class="status-dot @(Model.Settings.PollingEnabled ? "online" : "offline")"></span>@(Model.Settings.PollingEnabled ? "Polling فعال" : "Polling متوقف")</div>
</div>
<div class="stat-grid mb-4">
    @foreach (var item in Model.Counts)
    {
        <a class="stat-card" asp-controller="Jobs" asp-action="Index" asp-route-status="@item.Key"><span>@item.Key</span><strong>@item.Value</strong></a>
    }
</div>
<div class="row g-4">
    <div class="col-lg-8"><div class="panel"><div class="panel-heading"><h2>آخرین پردازش‌ها</h2><a asp-controller="Jobs" asp-action="Index">مشاهده همه</a></div>
        @if (Model.RecentJobs.Count == 0) { <div class="empty-state">هنوز تیکتی وارد صف نشده است.</div> }
        else { <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>تیکت</th><th>Provider</th><th>وضعیت</th><th>زمان</th></tr></thead><tbody>
        @foreach (var job in Model.RecentJobs) { <tr><td><a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id">#@job.ExternalTicketId · @job.Title</a></td><td>@job.Provider</td><td><span class="badge status-@job.Status.ToString().ToLowerInvariant()">@job.Status</span></td><td class="ltr">@job.DiscoveredAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td></tr> }
        </tbody></table></div> }
    </div></div>
    <div class="col-lg-4"><div class="panel h-100"><div class="panel-heading"><h2>پیکربندی فعال</h2></div><dl class="config-list"><dt>AI Provider</dt><dd>@Model.Settings.SelectedProvider</dd><dt>بازه بررسی</dt><dd>@Model.Settings.PollIntervalSeconds ثانیه</dd><dt>جدول تیکت</dt><dd class="ltr">@Model.Settings.TicketTable</dd><dt>شاخه مبنا</dt><dd class="ltr">@Model.Settings.DefaultBaseRef</dd><dt>Push</dt><dd>@(Model.Settings.PushEnabled ? "فعال" : "غیرفعال")</dd></dl><a class="btn btn-primary w-100" asp-controller="Settings" asp-action="Index">ویرایش تنظیمات</a></div></div>
</div>
